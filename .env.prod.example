# nookbox 운영 환경변수 템플릿.
#   cp .env.prod.example .env.prod  후 값을 채운다.
#   .env.prod 는 커밋하지 않는다(.gitignore 확인).
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- RP 자체 DB -------------------------------------------
# IdP 의 DB 와 완전히 별개다. 여기엔 RP 계정/세션만 들어간다.
POSTGRES_USER=nookbox
POSTGRES_PASSWORD=
POSTGRES_DB=nookbox

# --- 공개 주소 --------------------------------------------
# 브라우저가 실제로 접속하는 주소. apex 도메인을 쓴다.
#
# ⚠️ web 과 server 가 이 한 오리진을 공유하고 경로로 나뉜다:
#      /api/auth/*  → server (better-auth)
#      그 외         → web
#    RP 세션 쿠키를 이 한 호스트에 host-only 로 묶기 위한 구성이다.
#    server 를 api.nook-box.com 같은 별도 호스트로 쪼개면 쿠키가 그쪽에만
#    저장되어 web 의 서버 컴포넌트가 세션을 못 읽는다.
#
# ⚠️ 이 값은 NEXT_PUBLIC_API_URL 로 JS 번들에 박히므로,
#    바꾸면 web 을 반드시 --build 로 다시 만들어야 한다.
#
# ⚠️ 이 값을 바꾸면 IdP 에 등록한 redirect_uri 도 함께 갱신해야 한다:
#      <PUBLIC_ORIGIN>/api/auth/oauth2/callback/<OIDC_PROVIDER_ID>
PUBLIC_ORIGIN=https://nook-box.com

# --- better-auth ------------------------------------------
# RP 쿠키/토큰 서명 시크릿. openssl rand -hex 32
# ⚠️ IdP 의 BETTER_AUTH_SECRET 과 같은 값을 쓰지 말 것. 서로 무관한 시크릿이다.
BETTER_AUTH_SECRET=

# --- IdP 연동 (OIDC) --------------------------------------
# IdP 의 issuer. idp 스택의 PUBLIC_ORIGIN + /api/auth 다.
#
# 컨테이너에서 이 주소로 나가면 Cloudflare 를 한 바퀴 돌아 터널로 되돌아온다.
# 같은 맥미니 안이라 돌아 나가는 게 낭비처럼 보이지만,
# discovery 문서의 issuer 값과 여기 적은 값이 정확히 일치해야 하고
# (auth.ts 의 requireIssuerValidation: true), 내부 주소로 질러가면
# 두 스택을 또 하나의 네트워크로 묶어야 해서 결합만 늘어난다.
# discovery 응답은 캐시되므로 매 요청 나가는 것도 아니다.
OIDC_ISSUER=https://id.nook-box.com/api/auth

# IdP 에 등록된 클라이언트 값. idp 의 seed-oauth-client.ts 가 만든
# "Nook Backend" 클라이언트를 그대로 쓴다.
# ⚠️ 1st-party 앱이므로 IdP 쪽에서 그 클라이언트의 skip_consent 를 true 로 켜둘 것.
#    안 켜면 내 서비스에 로그인할 때마다 내 IdP 의 동의 화면이 뜬다.
OIDC_PROVIDER_ID=nook-auth
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- 호스트 포트 ------------------------------------------
# 127.0.0.1 에만 바인딩된다. 외부 노출은 idp 스택의 cloudflared 가 담당하므로
# 여기 값은 서버에서 직접 curl 로 확인할 때만 쓰인다.
# idp 스택이 8080(auth-web)/8081(auth)을 쓰고 있어 겹치지 않게 잡았다.
SERVER_HOST_PORT=8082
WEB_HOST_PORT=8083
